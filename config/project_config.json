{
  "project": {
    "name": "Secure & Explainable AI-Powered SOC",
    "random_seed": 42
  },
  "paths": {
    "raw_data": "data/raw",
    "processed_data": "data/processed",
    "experimental_data": "data/experimental",
    "models": "models",
    "experiments": "experiments",
    "results": "results"
  },
  "preprocessing": {
    "categorical_features": [
      "user",
      "country",
      "device",
      "protocol"
    ],
    "numerical_features": [
      "hour",
      "failed_attempts",
      "distance_km",
      "session_minutes",
      "bytes_out_mb"
    ],
    "excluded_columns": [
      "event_id",
      "is_attack"
    ],
    "training_strategy": "normal_only",
    "scaling": "standard",
    "categorical_encoding": "one_hot",
    "handle_unknown_categories": "ignore"
  },
  "detection": {
    "isolation_forest": {
      "enabled": true,
      "n_estimators": 100,
      "random_state": 42
    },
    "autoencoder": {
      "enabled": true,
      "random_seed": 42
    }
  },
  "experiment": {
    "conditions": [
      "baseline",
      "adversarial",
      "defended"
    ]
  }
}